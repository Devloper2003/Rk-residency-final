# Local development: SQLite (file-based, no setup needed)
# DATABASE_URL="file:/home/z/my-project/db/custom.db"
ADMIN_SESSION_SECRET="rk-residency-change-in-prod"

# Production: PostgreSQL (e.g. Neon, Supabase, RDS)
# Get this from your Postgres provider's dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Canonical production origin used for EVERY canonical, og:url, sitemap URL
# and redirect target. Must match the final domain exactly (no trailing slash).
# This is the ONLY place the domain is configured — never hardcode it elsewhere.
SITE_URL="https://www.rkresidencyvrindavan.in"

# --- Blog automation (Phase 3) ---
# Server-side ONLY. Used by /api/admin/generate-draft and the monthly cron
# to call Anthropic. Never referenced in client components; never commit the
# real key.
ANTHROPIC_API_KEY=""
# Optional — defaults to "claude-sonnet-4-6".
# ANTHROPIC_MODEL="claude-sonnet-4-6"

# Shared secret that protects the cron endpoints:
#   /api/cron/publish-posts   (hourly — publishes due SCHEDULED posts)
#   /api/cron/monthly-drafts  (1st of month — drafts next month's events)
# Vercel Cron sends it as: Authorization: Bearer <CRON_SECRET>
# For manual runs from the admin panel the admin session is accepted instead.
CRON_SECRET=""
